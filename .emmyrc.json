{
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua"
    ],
    "requireLikeFunction": [
      "LoadModule",
      "PLoadModule"
    ],
    "nonstandardSymbol": [
      "+="
    ]
  },
  "diagnostics": {
    "severity": {
      "global-in-non-module": "hint",
      "inject-field": "hint",
      "unnecessary-assert": "hint",
      "unnecessary-if": "hint"
    }
  },
  "workspace": {
    "workspaceRoots": [
      "./src",
      "./spec"
    ],
    "library": [
      "./runtime/lua",
      "./types"
    ],
    "ignoreGlobs": [
      "**/TreeData/**",
      "**/Data/ModCache.lua",
      "**/Data/Skills/**",
      "**/Data/StatDescriptions/**",
      "**/Data/TimelessJewelData/**",
      "**/Data/Bases/**",
      "**/Data/BeastCraft.lua",
      "**/Data/Bosses.lua",
      "**/Data/BossSkills.lua",
      "**/Data/ClusterJewels.lua",
      "**/Data/Costs.lua",
      "**/Data/Crucible.lua",
      "**/Data/CurrencyNames.lua",
      "**/Data/Enchantment*.lua",
      "**/Data/Essence.lua",
      "**/Data/FlavourText.lua",
      "**/Data/Gems.lua",
      "**/Data/Minions.lua",
      "**/Data/Misc.lua",
      "**/Data/ModCorrupted.lua",
      "**/Data/ModDelve.lua",
      "**/Data/ModEldritch.lua",
      "**/Data/ModExplicit.lua",
      "**/Data/ModFlask.lua",
      "**/Data/ModFoulborn.lua",
      "**/Data/ModFoulbornMap.lua",
      "**/Data/ModGraft.lua",
      "**/Data/ModItemExclusive.lua",
      "**/Data/ModJewel.lua",
      "**/Data/ModJewelAbyss.lua",
      "**/Data/ModJewelCharm.lua",
      "**/Data/ModJewelCluster.lua",
      "**/Data/ModMaster.lua",
      "**/Data/ModMercenary.lua",
      "**/Data/ModNecropolis.lua",
      "**/Data/ModScalability.lua",
      "**/Data/ModScourge.lua",
      "**/Data/ModSynthesis.lua",
      "**/Data/ModTincture.lua",
      "**/Data/ModVeiled.lua",
      "**/Data/Pantheons.lua",
      "**/Data/PearlSupports.lua",
      "**/Data/QueryMods.lua",
      "**/Data/Rares.lua",
      "**/Data/Spectres.lua",
      "**/Data/TattooPassives.lua",
      "**/Data/TradeSiteStats.lua",
      "**/Export/**"
    ]
  }
}
