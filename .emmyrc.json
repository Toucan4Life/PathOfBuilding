{
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "?.lua",
      "?/init.lua"
    ],
    "requireLikeFunction": [
      "LoadModule",
      "PLoadModule"
    ],
    "nonstandardSymbol": [
      "+="
    ]
  },
  "diagnostics": {
    "severity": {
      "global-in-non-module": "hint",
      "inject-field": "hint",
      "unnecessary-assert": "hint",
      "unnecessary-if": "hint"
    }
  },
  "workspace": {
    "workspaceRoots": [
      "./src",
      "./spec"
    ],
    "library": [
      "./runtime/lua",
      "./types"
    ],
    "ignoreGlobs": [
      "**/TreeData/**",
      "**/Data/Skills/**",
      "**/Data/StatDescriptions/**",
      "**/Data/TimelessJewelData/**",
      "**/Data/Bases/**",
      "**/Data/Mod[A-Z]*.lua",
      "**/Data/Enchantment*.lua",
      "**/Data/{ModCache,BeastCraft,Bosses,BossSkills,ClusterJewels,Costs,Crucible,CurrencyNames,Essence,FlavourText,Gems,Minions,Misc,Pantheons,PearlSupports,QueryMods,Rares,Spectres,TattooPassives,TradeSiteStats}.lua",
      "**/Export/**",
      "**/*_spec.lua",
      "**/System/**",
      "**/GenerateBuilds.lua",
      "**/sha2.lua"
    ]
  }
}
